# Copy this file to .env.local and fill the values before running the app.
# Generate a strong secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Required by Auth.js / NextAuth: a strong secret for signing tokens
AUTH_SECRET=replace_with_generated_secret_here

# OIDC provider credentials for the tcss460 provider used in `auth.ts`
AUTH_TCSS460_ID=your_client_id_here
AUTH_TCSS460_SECRET=your_client_secret_here
AUTH_TCSS460_AUDIENCE=your_audience_here

# Optional: set the NEXTAUTH_URL if needed (default is http://localhost:3000)
# NEXTAUTH_URL=http://localhost:3000
